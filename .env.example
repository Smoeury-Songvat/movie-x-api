# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=movieapp

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_secret_256bit
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_strong_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP (Email) ───────────────────────────────────────────────────────────────
# Free option: use Brevo (formerly Sendinblue) free tier — 300 emails/day
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your_brevo_smtp_login
MAIL_PASS=your_brevo_smtp_password
MAIL_FROM=noreply@movieapp.dev
OTP_EXPIRES_MINUTES=10
